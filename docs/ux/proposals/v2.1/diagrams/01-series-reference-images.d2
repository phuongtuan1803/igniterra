direction: down
series: "Create Series Bible (name or from Task)"
style: "Define style, voice, pronunciation"
character: "Add character + description"
choice: "Reference image source?" {shape: diamond}
upload: "Upload image + source + usage rights"
gen: "Generate AI reference image (paid)"
candidate: "Candidate gallery: not yet approved"
validate: "Validate image and inspect previews"
