direction: down
entry: "Import new or Add version from detail"
files: "Select GUI / API JSON files"
validate: "Preview: parse, validate, duplicate search"
dup: "Same content found?" {shape: diamond}
reuse: "Use existing workflow (no duplicate write)"
save: "Confirm import / immutable revision"
need: "Missing dependency?" {shape: diamond}
review: "Review pinned manifest + license"
approve: "Approve using existing ComfyService"
inputs: "Single Run form: mapped inputs only"
type: "Image or Motion?" {shape: diamond}
image: "Prompt / image if mapped"
motion: "Source image / prompt / duration if mapped"
gpu: "Choose ready GPU; confirm cost"
run: "ComfyService: validate + submit once"
verify: "Reconcile + verify image/video output"
blocked: "Explain first blocker, no paid submit"
entry -> files -> validate -> dup
dup -> reuse: "yes"
dup -> save: "new/explicit"
save -> need
need -> review: "yes"
review -> approve -> inputs
need -> inputs: "no"
inputs -> type
type -> image -> gpu: "Image"
type -> motion -> gpu: "Motion (after backend integration)"
gpu -> run -> verify
inputs -> blocked: "missing mapping / GPU / approval"
blocked -> inputs: "after fix"
