Dialogue: 0,0:00:00.10,0:00:01.59,Default,,0,0,0,,Cô gái vẫn gửi\Nthư tới một ngôi
Dialogue: 0,0:00:01.59,0:00:03.16,Default,,0,0,0,,sao mà ai cũng\Nnói đã chết
Dialogue: 0,0:00:04.00,0:00:04.75,Default,,0,0,0,,Mỗi đêm
Dialogue: 0,0:00:04.89,0:00:05.96,Default,,0,0,0,,cô lên đài quan sát
Dialogue: 0,0:00:06.19,0:00:08.26,Default,,0,0,0,,đặt giấy vào máy\Nphát và hướng ăng-ten
Dialogue: 0,0:00:09.23,0:00:10.38,Default,,0,0,0,,Người trong thị trấn bảo
Dialogue: 0,0:00:10.38,0:00:11.48,Default,,0,0,0,,chẳng có ai trả lời
Dialogue: 0,0:00:12.32,0:00:14.56,Default,,0,0,0,,Họ chỉ vào nơi ngôi\Nsao đã tắt từ lâu
Dialogue: 0,0:00:15.40,0:00:16.81,Default,,0,0,0,,Cô vẫn trở lại liên tục
Dialogue: 0,0:00:17.77,0:00:18.49,Default,,0,0,0,,Một đêm
Dialogue: 0,0:00:18.64,0:00:20.65,Default,,0,0,0,,máy thu phát tiếng\Nngười giữa lớp nhiễu
Dialogue: 0,0:00:21.49,0:00:22.52,Default,,0,0,0,,Con còn thức không?
Dialogue: 0,0:00:23.35,0:00:24.22,Default,,0,0,0,,Cô đứng sững
Dialogue: 0,0:00:24.37,0:00:25.45,Default,,0,0,0,,giọng ấy giống cha
Dialogue: 0,0:00:25.63,0:00:26.87,Default,,0,0,0,,người mất tích\Ntrong chuyến
Dialogue: 0,0:00:26.87,0:00:27.84,Default,,0,0,0,,thám hiểm năm xưa
Dialogue: 0,0:00:28.78,0:00:29.71,Default,,0,0,0,,Tín hiệu tiếp tục
Dialogue: 0,0:00:29.92,0:00:31.95,Default,,0,0,0,,như một bức thư mắc\Nkẹt trong thời gian
Dialogue: 0,0:00:32.78,0:00:34.58,Default,,0,0,0,,Cha kể về đêm\Ncuối trên con tàu
Dialogue: 0,0:00:34.76,0:00:36.24,Default,,0,0,0,,rồi gửi lời chào về nhà
Dialogue: 0,0:00:37.08,0:00:38.30,Default,,0,0,0,,Cô nghe đến sáng
Dialogue: 0,0:00:39.25,0:00:39.82,Default,,0,0,0,,Cuối cùng
Dialogue: 0,0:00:39.99,0:00:41.22,Default,,0,0,0,,cô thấy thời\Nđiểm truyền đi
Dialogue: 0,0:00:41.41,0:00:43.55,Default,,0,0,0,,cha đã trả lời trước\Nkhi cô bắt đầu gửi
Dialogue: 0,0:00:44.39,0:00:45.69,Default,,0,0,0,,Ông không nghe thấy cô
Dialogue: 0,0:00:46.52,0:00:47.95,Default,,0,0,0,,Ánh sáng chỉ vừa tới nơi
Dialogue: 0,0:00:48.11,0:00:49.84,Default,,0,0,0,,mang giọng nói từ\Nnhiều năm trước
Dialogue: 0,0:00:50.67,0:00:51.86,Default,,0,0,0,,Cô đặt lá thư xuống
Dialogue: 0,0:00:52.01,0:00:53.14,Default,,0,0,0,,bầu trời lặng im
