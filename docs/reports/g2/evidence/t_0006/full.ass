Dialogue: 0,0:00:00.10,0:00:02.20,Default,,0,0,0,,Robot vẫn tưới một\Nchậu đất suốt nhiều
Dialogue: 0,0:00:02.20,0:00:03.68,Default,,0,0,0,,năm sau khi con\Nngười biến mất
Dialogue: 0,0:00:04.51,0:00:06.01,Default,,0,0,0,,Giữa những\Nđại lộ phủ bụi
Dialogue: 0,0:00:06.18,0:00:07.90,Default,,0,0,0,,nó đi qua các\Ncửa kính tối om
Dialogue: 0,0:00:08.09,0:00:10.06,Default,,0,0,0,,nghe gió luồn trong\Nnhững tòa nhà rỗng
Dialogue: 0,0:00:10.90,0:00:12.66,Default,,0,0,0,,Không còn bước\Nchân nào đáp lại
Dialogue: 0,0:00:13.61,0:00:15.12,Default,,0,0,0,,Trong kho chứa\Nngập nước mưa
Dialogue: 0,0:00:15.29,0:00:16.55,Default,,0,0,0,,robot tìm thấy một bình
Dialogue: 0,0:00:16.55,0:00:17.59,Default,,0,0,0,,kim loại còn nguyên
Dialogue: 0,0:00:18.42,0:00:20.40,Default,,0,0,0,,Nó kéo bình về\Nbằng đôi tay máy
Dialogue: 0,0:00:20.56,0:00:21.92,Default,,0,0,0,,chậm chạp\Nnhưng chính xác
Dialogue: 0,0:00:22.12,0:00:23.51,Default,,0,0,0,,rồi nghiêng vòi\Ntrên chậu đất
Dialogue: 0,0:00:24.35,0:00:25.26,Default,,0,0,0,,Nước rơi xuống
Dialogue: 0,0:00:25.45,0:00:27.14,Default,,0,0,0,,thấm vào lớp đất\Nnâu lạnh ngắt
Dialogue: 0,0:00:28.08,0:00:29.11,Default,,0,0,0,,Những ngày tiếp theo
Dialogue: 0,0:00:29.28,0:00:30.51,Default,,0,0,0,,thành phố vẫn im lặng
Dialogue: 0,0:00:30.68,0:00:32.18,Default,,0,0,0,,còn robot vẫn quay lại
Dialogue: 0,0:00:33.02,0:00:35.13,Default,,0,0,0,,Đèn báo trên lưng nó\Nchuyển sang màu đỏ
Dialogue: 0,0:00:35.31,0:00:37.16,Default,,0,0,0,,pin chỉ đủ cho\Nvài chu kỳ nữa
Dialogue: 0,0:00:38.00,0:00:39.16,Default,,0,0,0,,Nó tắt đèn đường
Dialogue: 0,0:00:39.32,0:00:40.38,Default,,0,0,0,,khóa các cánh cửa
Dialogue: 0,0:00:40.55,0:00:41.92,Default,,0,0,0,,dành phần năng\Nlượng cuối cùng
Dialogue: 0,0:00:41.92,0:00:43.15,Default,,0,0,0,,sưởi ấm chậu đất trống
Dialogue: 0,0:00:44.09,0:00:45.82,Default,,0,0,0,,Robot tắt đi\Nđúng lúc một mầm
Dialogue: 0,0:00:45.82,0:00:46.97,Default,,0,0,0,,xanh đội đất trồi lên
Dialogue: 0,0:00:47.12,0:00:48.80,Default,,0,0,0,,khi sự sống đầu\Ntiên trở lại
